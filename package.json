{
  "name": "claudetui",
  "version": "0.1.0",
  "description": "Terminal dashboard for monitoring Claude Code sessions, token usage, and agent activity",
  "type": "module",
  "bin": {
    "claudetui": "./dist/claudetui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adirksen/claudetui.git"
  },
  "homepage": "https://github.com/adirksen/claudetui#readme",
  "bugs": {
    "url": "https://github.com/adirksen/claudetui/issues"
  },
  "scripts": {
    "dev": "tsx bin/claudetui.ts",
    "setup": "node scripts/setup.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "build": "esbuild bin/claudetui.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/claudetui.js --external:neo-blessed --external:blessed --external:blessed-contrib --external:term.js --external:pty.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "terminal",
    "dashboard",
    "tui",
    "monitor",
    "token-usage",
    "cost-tracking",
    "htop"
  ],
  "author": "Anthony Dirksen",
  "license": "MIT",
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chokidar": "^4.0.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
